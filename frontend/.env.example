# Backend origin without a trailing slash.
REACT_APP_BACKEND_URL=http://localhost:8001

# Development-only mock mode. Do not enable for real backend verification.
REACT_APP_PREVIEW_MODE=false

# Optional error tracking. Leave empty to disable Sentry entirely
# (the SDK is not even loaded without it).
REACT_APP_SENTRY_DSN=

# Fixture-only PostHog proof. off is the default; local dispatches sanitized
# cvfpt:analytics browser events, with no network or credentials.
# synthetic-preview additionally requires separate bounded collection approval.
# All Production/non-preview builds and all real-data modes are force-disabled.
REACT_APP_POSTHOG_MODE=off
REACT_APP_POSTHOG_HOST=
REACT_APP_POSTHOG_PUBLIC_TOKEN=
