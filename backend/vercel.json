{
  "version": 2,
  "git": {
    "deploymentEnabled": {
      "release/pt-local-20261031": false,
      "codex/email-brand-preview": false,
      "codex/email-yahoo-contrast": false,
      "codex/series-calendar-direction": false,
      "codex/signup-session-race": false
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/internal/digest", "schedule": "0 13 * * *" }
  ]
}
